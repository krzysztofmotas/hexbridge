# Local research scratch (original Ross-Tech file copies, IDA database,
# raw tool output) - not part of the product, kept out of git entirely.
analysis/
artifacts/

# Raw FTDI CDM download and its extraction - large vendor binaries,
# easily re-obtained from ftdichip.com (see driver/redist/README.txt
# for the exact version/URL/SHA-256 to reproduce).
tools/

# Genuine FTDI redistributable binaries - vendor files, not ours to
# version-control. See driver/redist/README.txt + SHA256SUMS.txt for
# exactly which CDM version/files these must be and how to reproduce.
driver/redist/*.sys
driver/redist/*.dll

# Build outputs (regenerated by driver/dll-shim/build.ps1 from RT-USB.def)
driver/dll-shim/*.dll
driver/dll-shim/*.lib
driver/dll-shim/*.exp

# Assembled/signed test install package - derived entirely from
# driver/inf/ + driver/redist/, regenerated locally by
# scripts/build-test-package.ps1. Contains vendor binaries and a local
# test certificate, neither of which belong in version control.
driver/package/
